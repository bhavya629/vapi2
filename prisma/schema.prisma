generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_MANAGER
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum DeliveryType {
  SAME_DAY_LOCAL
  OUTSTATION_CONFIRMATION
  OUTSTATION_STANDARD
  STORE_PICKUP
}

enum DeliveryZone {
  WITHIN_50_KM
  BEYOND_50_KM
  NEEDS_VERIFICATION
  NOT_APPLICABLE
}

enum ShippingChargeStatus {
  FIXED
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  NOT_APPLICABLE
}

enum DeliveryStatus {
  AWAITING_ASSIGNMENT
  AWAITING_DISTANCE_VERIFICATION
  AWAITING_SHIPPING_CONFIRMATION
  SHIPPING_CONFIRMED
  PACKAGING_PENDING
  PACKED
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  SHIPPED
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum ShippingConfirmationMethod {
  PHONE_CALL
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  OTHER
}

enum SameDayReasonCode {
  ELIGIBLE
  AFTER_CUTOFF
  OUT_OF_RADIUS
  ADDRESS_UNVERIFIED
  SAME_DAY_DISABLED
  STORE_PICKUP
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  SESSION_REVOKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  PROFILE_UPDATED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ProductType {
  SMARTPHONE
  ACCESSORY
}

enum ProductImageType {
  FRONT
  BACK
  SIDE
  ANGLE
  OTHER
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PAY_AT_STORE
  ONLINE
}

enum FulfilmentMethod {
  DELIVERY
  STORE_PICKUP
}

enum OrderActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum EnquiryCategory {
  GENERAL
  PRODUCT_INFORMATION
  STOCK_AVAILABILITY
  ORDER_SUPPORT
  PAYMENT_SUPPORT
  DELIVERY_SUPPORT
  CANCELLATION_REQUEST
  RETURN_OR_REFUND
  WARRANTY_SUPPORT
  WEBSITE_SUPPORT
  OTHER
}

enum EnquiryStatus {
  OPEN
  IN_REVIEW
  WAITING_FOR_CUSTOMER
  WAITING_FOR_STORE
  RESOLVED
  CLOSED
  SPAM
}

enum EnquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EnquirySource {
  CONTACT_PAGE
  ACCOUNT
  ORDER_DETAIL
  GUEST
}

enum EnquiryMessageAuthor {
  CUSTOMER
  ADMIN
  SYSTEM
  GUEST
}

enum InventoryReason {
  INITIAL_STOCK
  ADMIN_ADJUSTMENT
  RESTOCK
  ORDER_DEDUCTION
  ORDER_CANCELLATION
  RETURN
  CORRECTION
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Decimal    @db.Decimal(10, 2)
  minimumOrder    Decimal?   @db.Decimal(10, 2)
  maximumDiscount Decimal?   @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int        @default(0)
  startsAt        DateTime
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([isActive, expiresAt])
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  buttonLabel    String?
  isActive       Boolean   @default(true)
  displayOrder   Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, displayOrder])
}

model StoreSettings {
  id           String   @id @default("default")
  storeName    String   @default("The Cellphone Studio")
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  logoUrl      String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  updatedAt    DateTime @updatedAt
}

model User {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  phone                 String?
  passwordHash          String
  role                  UserRole   @default(CUSTOMER)
  status                UserStatus @default(ACTIVE)
  lastLoginAt           DateTime?
  lastPasswordChangedAt DateTime?
  failedLoginCount      Int        @default(0)
  lastFailedLoginAt     DateTime?
  lockedUntil           DateTime?
  suspendedAt           DateTime?
  suspendedReason       String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  orders             Order[]
  addresses          Address[]
  orderStatusHistory OrderStatusHistory[]
  payments           Payment[]
  wishlistItems      WishlistItem[]
  enquiries          Enquiry[]
  enquiryMessages    EnquiryMessage[]
  inventoryMovements InventoryMovement[]
  adminAuditLogs     AdminAuditLog[]
  sessions           Session[]
  authEvents         AuthEvent[]
  passwordHistory    PasswordHistory[]
  reviews            Review[]
  reviewVotes        ReviewVote[]
  reviewReports      ReviewReport[]
  managedDeliveries  Order[]                 @relation("DeliveryManagerOrders")
  deliveryHistory    DeliveryStatusHistory[] @relation("DeliveryStatusActor")
  shippingConfirmed  ShippingConfirmation[]  @relation("ShippingConfirmedBy")
  deliveryOperations DeliveryOperation[]     @relation("DeliveryOperationManager")
  deliveryContacts   DeliveryContactLog[]    @relation("DeliveryContactActor")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  deviceLabel  String?
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthEvent {
  id              String        @id @default(cuid())
  userId          String?
  emailNormalized String
  eventType       AuthEventType
  success         Boolean
  failureReason   String?
  ipHash          String?
  userAgent       String?
  deviceLabel     String?
  createdAt       DateTime      @default(now())
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([emailNormalized, createdAt])
  @@index([eventType, createdAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Address {
  id             String      @id @default(cuid())
  userId         String
  label          String      @default("Home")
  recipientName  String
  phone          String
  alternatePhone String?
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  postalCode     String
  country        String      @default("India")
  district       String?
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  addressType    AddressType @default(HOME)
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Product {
  id                String      @id @default(cuid())
  legacyId          Int?
  slug              String      @unique
  sku               String?     @unique
  name              String
  shortDescription  String?
  description       String
  productType       ProductType
  brandId           String
  categoryId        String
  price             Decimal     @db.Decimal(10, 2)
  originalPrice     Decimal?    @db.Decimal(10, 2)
  stock             Int         @default(0)
  reservedStock     Int         @default(0)
  lowStockThreshold Int         @default(3)
  imageUrl          String
  specifications    Json?
  compatibility     Json?
  rating            Decimal?    @db.Decimal(2, 1)
  reviewCount       Int         @default(0)
  averageRating     Decimal     @default(0) @db.Decimal(3, 2)
  totalReviews      Int         @default(0)
  rating1           Int         @default(0)
  rating2           Int         @default(0)
  rating3           Int         @default(0)
  rating4           Int         @default(0)
  rating5           Int         @default(0)
  isActive          Boolean     @default(true)
  isFeatured        Boolean     @default(false)
  displayOrder      Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brand                 Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  inventoryMovements    InventoryMovement[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]
  wishlistItems         WishlistItem[]
  reviews               Review[]
  variants              ProductVariant[]
  colours               ProductColour[]

  @@unique([productType, legacyId])
  @@index([productType])
  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([price])
  @@index([productType, isActive, displayOrder])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  ram          String
  storage      String
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  combinations ProductVariantColour[]
  orderItems   OrderItem[]

  @@unique([productId, ram, storage])
  @@index([productId, isActive, displayOrder])
}

model ProductColour {
  id           String   @id @default(cuid())
  productId    String
  name         String
  slug         String
  hexCode      String?
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  combinations ProductVariantColour[]

  @@unique([productId, slug])
  @@unique([productId, name])
  @@index([productId, isActive, displayOrder])
}

model ProductVariantColour {
  id                String   @id @default(cuid())
  productVariantId  String
  productColourId   String
  sku               String   @unique
  price             Decimal  @db.Decimal(10, 2)
  originalPrice     Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(3)
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant        ProductVariant                @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  colour         ProductColour                 @relation(fields: [productColourId], references: [id], onDelete: Restrict)
  images         ProductVariantImage[]
  specifications ProductVariantSpecification[]
  orderItems     OrderItem[]
  reservations   InventoryReservation[]
  movements      InventoryMovement[]

  @@unique([productVariantId, productColourId])
  @@index([productVariantId, isActive, displayOrder])
  @@index([productColourId, isActive])
  @@index([stock, reservedStock])
}

model ProductVariantSpecification {
  id                     String   @id @default(cuid())
  productVariantColourId String
  key                    String
  value                  String
  displayOrder           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  combination ProductVariantColour @relation(fields: [productVariantColourId], references: [id], onDelete: Cascade)

  @@unique([productVariantColourId, key])
  @@index([productVariantColourId])
}

model ProductVariantImage {
  id                     String           @id @default(cuid())
  productVariantColourId String
  imageUrl               String
  altText                String?
  imageType              ProductImageType @default(OTHER)
  isPrimary              Boolean          @default(false)
  displayOrder           Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  combination ProductVariantColour @relation(fields: [productVariantColourId], references: [id], onDelete: Cascade)

  @@index([productVariantColourId, displayOrder])
}

model Brand {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  logoUrl      String?
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([isActive, displayOrder])
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  imageUrl     String?
  productType  ProductType
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products Product[]

  @@index([productType, isActive, displayOrder])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model InventoryMovement {
  id              String          @id @default(cuid())
  productId       String
  quantityChange  Int
  previousStock   Int
  newStock        Int
  reason          InventoryReason
  referenceType   String?
  referenceId     String?
  note            String?
  adminUserId     String?
  variantColourId String?
  createdAt       DateTime        @default(now())

  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminUser     User?                 @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  variantColour ProductVariantColour? @relation(fields: [variantColourId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([adminUserId])
  @@index([variantColourId, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Order {
  id                          String                      @id @default(cuid())
  orderNumber                 String                      @unique
  userId                      String
  fullName                    String
  phone                       String
  address                     String
  city                        String
  postalCode                  String
  total                       Decimal                     @db.Decimal(10, 2)
  status                      OrderStatus                 @default(PENDING)
  paymentStatus               PaymentStatus               @default(PENDING)
  paymentMethod               PaymentMethod               @default(CASH_ON_DELIVERY)
  fulfilmentMethod            FulfilmentMethod            @default(DELIVERY)
  subtotal                    Decimal                     @default(0) @db.Decimal(10, 2)
  deliveryCharge              Decimal                     @default(0) @db.Decimal(10, 2)
  discount                    Decimal                     @default(0) @db.Decimal(10, 2)
  tax                         Decimal                     @default(0) @db.Decimal(10, 2)
  currency                    String                      @default("INR")
  customerEmail               String                      @default("")
  addressLabel                String?
  recipientName               String?
  shippingPhone               String?
  addressLine1                String?
  addressLine2                String?
  landmark                    String?
  state                       String?
  country                     String?                     @default("India")
  customerNote                String?
  internalNote                String?
  idempotencyKey              String?
  requestHash                 String?
  placedAt                    DateTime                    @default(now())
  confirmedAt                 DateTime?
  packedAt                    DateTime?
  readyForPickupAt            DateTime?
  outForDeliveryAt            DateTime?
  cancelledAt                 DateTime?
  deliveredAt                 DateTime?
  cancellationReason          String?
  inventoryRestoredAt         DateTime?
  paidAt                      DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  deliveryType                DeliveryType?
  deliveryZone                DeliveryZone?
  deliveryDistanceKm          Decimal?                    @db.Decimal(8, 2)
  shippingChargeStatus        ShippingChargeStatus        @default(NOT_APPLICABLE)
  deliveryStatus              DeliveryStatus?
  deliveryManagerId           String?
  sameDayEligible             Boolean                     @default(false)
  sameDayReasonCode           SameDayReasonCode?
  estimatedDeliveryDate       DateTime?
  customerShippingConfirmedAt DateTime?
  shippingConfirmationMethod  ShippingConfirmationMethod?
  deliveryAddressSnapshot     Json?
  courierName                 String?
  courierTrackingNumber       String?
  courierTrackingUrl          String?
  pickupAt                    DateTime?
  shippedAt                   DateTime?
  deliveryFailedAt            DateTime?
  returnedAt                  DateTime?
  deliveryPublicNote          String?

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  reservations          InventoryReservation[]
  enquiries             Enquiry[]
  reviews               Review[]
  deliveryManager       User?                   @relation("DeliveryManagerOrders", fields: [deliveryManagerId], references: [id], onDelete: SetNull)
  deliveryStatusHistory DeliveryStatusHistory[]
  shippingConfirmation  ShippingConfirmation?
  deliveryOperation     DeliveryOperation?
  deliveryContactLogs   DeliveryContactLog[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, placedAt])
  @@index([deliveryManagerId, deliveryStatus])
  @@index([deliveryZone, shippingChargeStatus])
}

model DeliverySettings {
  id                   String   @id @default("default")
  storeName            String   @default("The Cellphone Studio")
  storeAddress         String   @default("Vapi, Gujarat, India")
  storeLatitude        Decimal? @db.Decimal(10, 7)
  storeLongitude       Decimal? @db.Decimal(10, 7)
  localRadiusKm        Decimal  @default(50) @db.Decimal(8, 2)
  localDeliveryCharge  Decimal  @default(350) @db.Decimal(10, 2)
  sameDayCutoff        String   @default("15:00")
  sameDayEnabled       Boolean  @default(true)
  indiaShippingEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model ShippingConfirmation {
  id              String                     @id @default(cuid())
  orderId         String                     @unique
  confirmedById   String
  method          ShippingConfirmationMethod
  charge          Decimal                    @db.Decimal(10, 2)
  customerConsent Boolean                    @default(true)
  note            String?
  confirmedAt     DateTime                   @default(now())
  order           Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  confirmedBy     User                       @relation("ShippingConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
}

model DeliveryOperation {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  managerId          String?
  packagingCost      Decimal? @db.Decimal(10, 2)
  courierCost        Decimal? @db.Decimal(10, 2)
  otherCost          Decimal? @db.Decimal(10, 2)
  revenue            Decimal? @db.Decimal(10, 2)
  profit             Decimal? @db.Decimal(10, 2)
  packagingChecklist Json?
  internalNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manager            User?    @relation("DeliveryOperationManager", fields: [managerId], references: [id], onDelete: SetNull)
}

model DeliveryStatusHistory {
  id                String          @id @default(cuid())
  orderId           String
  fromStatus        DeliveryStatus?
  toStatus          DeliveryStatus
  note              String?
  actorUserId       String?
  actorType         OrderActorType
  isCustomerVisible Boolean         @default(true)
  createdAt         DateTime        @default(now())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser         User?           @relation("DeliveryStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model DeliveryContactLog {
  id                String   @id @default(cuid())
  orderId           String
  actorUserId       String?
  channel           String
  outcome           String
  note              String?
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser         User?    @relation("DeliveryContactActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String               @id @default(cuid())
  orderId           String
  userId            String
  provider          PaymentProvider      @default(RAZORPAY)
  providerOrderId   String               @unique
  providerPaymentId String?              @unique
  signatureHash     String?
  status            PaymentAttemptStatus @default(CREATED)
  amount            Decimal              @db.Decimal(10, 2)
  currency          String               @default("INR")
  method            String?
  email             String?
  contact           String?
  errorCode         String?
  errorDescription  String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  captured          Boolean              @default(false)
  verifiedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model PaymentEvent {
  id                String          @id @default(cuid())
  provider          PaymentProvider @default(RAZORPAY)
  providerEventId   String          @unique
  eventType         String
  providerOrderId   String?
  providerPaymentId String?
  payloadHash       String
  processed         Boolean         @default(false)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([eventType, createdAt])
}

model InventoryReservation {
  id              String                @id @default(cuid())
  orderId         String
  productId       String
  variantColourId String?
  quantity        Int
  status          ReservationStatus     @default(ACTIVE)
  expiresAt       DateTime
  releasedAt      DateTime?
  convertedAt     DateTime?
  createdAt       DateTime              @default(now())
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantColour   ProductVariantColour? @relation(fields: [variantColourId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([productId, status])
  @@index([orderId, variantColourId])
  @@index([variantColourId, status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model Enquiry {
  id              String           @id @default(cuid())
  enquiryNumber   String           @unique
  userId          String?
  orderId         String?
  name            String
  email           String
  phone           String?
  subject         String
  category        EnquiryCategory
  status          EnquiryStatus    @default(OPEN)
  priority        EnquiryPriority  @default(NORMAL)
  source          EnquirySource    @default(CONTACT_PAGE)
  internalNote    String?
  lastRespondedAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages        EnquiryMessage[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([email])
}

model EnquiryMessage {
  id                String               @id @default(cuid())
  enquiryId         String
  authorUserId      String?
  authorType        EnquiryMessageAuthor
  message           String
  isCustomerVisible Boolean              @default(true)
  createdAt         DateTime             @default(now())
  enquiry           Enquiry              @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorUser        User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
}

model Review {
  id               String         @id @default(cuid())
  productId        String
  userId           String
  orderId          String
  rating           Int
  title            String
  comment          String
  status           ReviewStatus   @default(PENDING)
  verifiedPurchase Boolean        @default(true)
  helpfulCount     Int            @default(0)
  reportCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  votes            ReviewVote[]
  reports          ReviewReport[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId, createdAt])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([createdAt])
}

model OrderItem {
  id                     String      @id @default(cuid())
  orderId                String
  productId              String?
  productVariantId       String?
  productVariantColourId String?
  name                   String
  price                  Decimal     @db.Decimal(10, 2)
  quantity               Int
  productSlug            String      @default("")
  productName            String      @default("")
  productSku             String?
  productType            ProductType @default(SMARTPHONE)
  brandName              String      @default("")
  categoryName           String      @default("")
  imageUrl               String      @default("")
  specifications         Json?
  ram                    String?
  storage                String?
  colourName             String?
  variantSku             String?
  unitPrice              Decimal     @default(0) @db.Decimal(10, 2)
  originalPrice          Decimal?    @db.Decimal(10, 2)
  lineTotal              Decimal     @default(0) @db.Decimal(10, 2)
  createdAt              DateTime    @default(now())

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant       ProductVariant?       @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productVariantColour ProductVariantColour? @relation(fields: [productVariantColourId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([productVariantColourId])
}

model OrderStatusHistory {
  id                String         @id @default(cuid())
  orderId           String
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  actorUserId       String?
  actorType         OrderActorType
  isCustomerVisible Boolean        @default(true)
  createdAt         DateTime       @default(now())
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId])
}
