generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Decimal    @db.Decimal(10, 2)
  minimumOrder    Decimal?   @db.Decimal(10, 2)
  maximumDiscount Decimal?   @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int        @default(0)
  startsAt        DateTime
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([isActive, expiresAt])
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  buttonLabel    String?
  isActive       Boolean   @default(true)
  displayOrder   Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, displayOrder])
}

model StoreSettings {
  id           String   @id @default("default")
  storeName    String   @default("The Cellphone Studio")
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  logoUrl      String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  updatedAt    DateTime @updatedAt
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  email                 String                  @unique
  phone                 String?
  passwordHash          String
  role                  UserRole                @default(CUSTOMER)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  failedLoginCount      Int                     @default(0)
  lastFailedLoginAt     DateTime?
  lastLoginAt           DateTime?
  lastPasswordChangedAt DateTime?
  lockedUntil           DateTime?
  status                UserStatus              @default(ACTIVE)
  suspendedAt           DateTime?
  suspendedReason       String?
  addresses             Address[]
  adminAuditLogs        AdminAuditLog[]
  authEvents            AuthEvent[]
  deliveryContacts      DeliveryContactLog[]    @relation("DeliveryContactActor")
  deliveryOperations    DeliveryOperation[]     @relation("DeliveryOperationManager")
  deliveryHistory       DeliveryStatusHistory[] @relation("DeliveryStatusActor")
  enquiries             Enquiry[]
  enquiryMessages       EnquiryMessage[]
  inventoryMovements    InventoryMovement[]
  managedDeliveries     Order[]                 @relation("DeliveryManagerOrders")
  orders                Order[]
  orderStatusHistory    OrderStatusHistory[]
  passwordHistory       PasswordHistory[]
  payments              Payment[]
  reviews               Review[]
  reviewReports         ReviewReport[]
  reviewVotes           ReviewVote[]
  sessions              Session[]
  shippingConfirmed     ShippingConfirmation[]  @relation("ShippingConfirmedBy")
  wishlistItems         WishlistItem[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  deviceLabel  String?
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthEvent {
  id              String        @id @default(cuid())
  userId          String?
  emailNormalized String
  eventType       AuthEventType
  success         Boolean
  failureReason   String?
  ipHash          String?
  userAgent       String?
  deviceLabel     String?
  createdAt       DateTime      @default(now())
  user            User?         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([emailNormalized, createdAt])
  @@index([eventType, createdAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Address {
  id             String      @id @default(cuid())
  userId         String
  label          String      @default("Home")
  recipientName  String
  phone          String
  alternatePhone String?
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  postalCode     String
  country        String      @default("India")
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  addressType    AddressType @default(HOME)
  district       String?
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  description           String
  price                 Decimal                @db.Decimal(10, 2)
  imageUrl              String
  stock                 Int                    @default(0)
  productType           ProductType
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  brandId               String
  categoryId            String
  compatibility         Json?
  displayOrder          Int                    @default(0)
  isFeatured            Boolean                @default(false)
  legacyId              Int?
  lowStockThreshold     Int                    @default(3)
  originalPrice         Decimal?               @db.Decimal(10, 2)
  rating                Decimal?               @db.Decimal(2, 1)
  reviewCount           Int                    @default(0)
  shortDescription      String?
  sku                   String?                @unique
  specifications        Json?
  reservedStock         Int                    @default(0)
  averageRating         Decimal                @default(0) @db.Decimal(3, 2)
  rating1               Int                    @default(0)
  rating2               Int                    @default(0)
  rating3               Int                    @default(0)
  rating4               Int                    @default(0)
  rating5               Int                    @default(0)
  totalReviews          Int                    @default(0)
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  orderItems            OrderItem[]
  brand                 Brand                  @relation(fields: [brandId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  colours               ProductColour?
  images                ProductImage[]
  variants              ProductVariant?
  reviews               Review[]
  wishlistItems         WishlistItem[]

  @@unique([productType, legacyId])
  @@index([productType])
  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([price])
  @@index([productType, isActive, displayOrder])
}

model ProductVariant {
  id           String                @id @default(cuid())
  productId    String                @unique(map: "ProductVariant_one_default_per_product", where: raw("(\"isDefault\" = true)"))
  ram          String
  storage      String
  isActive     Boolean               @default(true)
  isDefault    Boolean               @default(false)
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  orderItems   OrderItem[]
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  combinations ProductVariantColour?

  @@unique([productId, ram, storage])
  @@index([productId, isActive, displayOrder])
}

model ProductColour {
  id           String                 @id @default(cuid())
  productId    String                 @unique(map: "ProductColour_one_default_per_product", where: raw("(\"isDefault\" = true)"))
  name         String
  slug         String
  hexCode      String?
  isActive     Boolean                @default(true)
  isDefault    Boolean                @default(false)
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  combinations ProductVariantColour[]

  @@unique([productId, slug])
  @@unique([productId, name])
  @@index([productId, isActive, displayOrder])
}

model ProductVariantColour {
  id                String                        @id @default(cuid())
  productVariantId  String                        @unique(map: "ProductVariantColour_one_default_per_variant", where: raw("(\"isDefault\" = true)"))
  productColourId   String
  sku               String                        @unique
  price             Decimal                       @db.Decimal(10, 2)
  originalPrice     Decimal?                      @db.Decimal(10, 2)
  stock             Int                           @default(0)
  reservedStock     Int                           @default(0)
  lowStockThreshold Int                           @default(3)
  isActive          Boolean                       @default(true)
  isDefault         Boolean                       @default(false)
  displayOrder      Int                           @default(0)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  movements         InventoryMovement[]
  reservations      InventoryReservation[]
  orderItems        OrderItem[]
  colour            ProductColour                 @relation(fields: [productColourId], references: [id])
  variant           ProductVariant                @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  images            ProductVariantImage?
  specifications    ProductVariantSpecification[]

  @@unique([productVariantId, productColourId])
  @@index([productVariantId, isActive, displayOrder])
  @@index([productColourId, isActive])
  @@index([stock, reservedStock])
}

model ProductVariantSpecification {
  id                     String               @id @default(cuid())
  productVariantColourId String
  key                    String
  value                  String
  displayOrder           Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  combination            ProductVariantColour @relation(fields: [productVariantColourId], references: [id], onDelete: Cascade)

  @@unique([productVariantColourId, key])
  @@index([productVariantColourId])
}

model ProductVariantImage {
  id                     String               @id @default(cuid())
  productVariantColourId String               @unique(map: "ProductVariantImage_one_primary_per_combination", where: raw("(\"isPrimary\" = true)"))
  imageUrl               String
  altText                String?
  imageType              ProductImageType     @default(OTHER)
  isPrimary              Boolean              @default(false)
  displayOrder           Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  combination            ProductVariantColour @relation(fields: [productVariantColourId], references: [id], onDelete: Cascade)

  @@index([productVariantColourId, displayOrder])
}

model Brand {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  logoUrl      String?
  description  String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([isActive, displayOrder])
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  imageUrl     String?
  productType  ProductType
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]

  @@index([productType, isActive, displayOrder])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String
  quantityChange  Int
  previousStock   Int
  newStock        Int
  reason          InventoryReason
  referenceType   String?
  referenceId     String?
  note            String?
  createdAt       DateTime              @default(now())
  adminUserId     String?
  variantColourId String?
  adminUser       User?                 @relation(fields: [adminUserId], references: [id])
  product         Product               @relation(fields: [productId], references: [id])
  variantColour   ProductVariantColour? @relation(fields: [variantColourId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([adminUserId])
  @@index([variantColourId, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  adminUser   User?    @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Order {
  id                          String                      @id @default(cuid())
  orderNumber                 String                      @unique
  userId                      String
  fullName                    String
  phone                       String
  address                     String
  city                        String
  postalCode                  String
  total                       Decimal                     @db.Decimal(10, 2)
  status                      OrderStatus                 @default(PENDING)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  addressLabel                String?
  addressLine1                String?
  addressLine2                String?
  cancelledAt                 DateTime?
  confirmedAt                 DateTime?
  country                     String?                     @default("India")
  currency                    String                      @default("INR")
  customerEmail               String                      @default("")
  customerNote                String?
  deliveredAt                 DateTime?
  deliveryCharge              Decimal                     @default(0) @db.Decimal(10, 2)
  discount                    Decimal                     @default(0) @db.Decimal(10, 2)
  fulfilmentMethod            FulfilmentMethod            @default(DELIVERY)
  idempotencyKey              String?
  internalNote                String?
  landmark                    String?
  paymentMethod               PaymentMethod               @default(CASH_ON_DELIVERY)
  paymentStatus               PaymentStatus               @default(PENDING)
  placedAt                    DateTime                    @default(now())
  recipientName               String?
  requestHash                 String?
  shippingPhone               String?
  state                       String?
  subtotal                    Decimal                     @default(0) @db.Decimal(10, 2)
  tax                         Decimal                     @default(0) @db.Decimal(10, 2)
  cancellationReason          String?
  inventoryRestoredAt         DateTime?
  outForDeliveryAt            DateTime?
  packedAt                    DateTime?
  readyForPickupAt            DateTime?
  paidAt                      DateTime?
  courierName                 String?
  courierTrackingNumber       String?
  courierTrackingUrl          String?
  customerShippingConfirmedAt DateTime?
  deliveryAddressSnapshot     Json?
  deliveryDistanceKm          Decimal?                    @db.Decimal(8, 2)
  deliveryFailedAt            DateTime?
  deliveryManagerId           String?
  deliveryPublicNote          String?
  deliveryStatus              DeliveryStatus?
  deliveryType                DeliveryType?
  deliveryZone                DeliveryZone?
  estimatedDeliveryDate       DateTime?
  pickupAt                    DateTime?
  returnedAt                  DateTime?
  sameDayEligible             Boolean                     @default(false)
  sameDayReasonCode           SameDayReasonCode?
  shippedAt                   DateTime?
  shippingChargeStatus        ShippingChargeStatus        @default(NOT_APPLICABLE)
  shippingConfirmationMethod  ShippingConfirmationMethod?
  deliveryContactLogs         DeliveryContactLog[]
  deliveryOperation           DeliveryOperation?
  deliveryStatusHistory       DeliveryStatusHistory[]
  enquiries                   Enquiry[]
  reservations                InventoryReservation[]
  deliveryManager             User?                       @relation("DeliveryManagerOrders", fields: [deliveryManagerId], references: [id])
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                       OrderItem[]
  statusHistory               OrderStatusHistory[]
  payments                    Payment[]
  reviews                     Review[]
  shippingConfirmation        ShippingConfirmation?

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, placedAt])
  @@index([deliveryManagerId, deliveryStatus])
  @@index([deliveryZone, shippingChargeStatus])
}

model DeliverySettings {
  id                   String   @id @default("default")
  storeName            String   @default("The Cellphone Studio")
  storeAddress         String   @default("Vapi, Gujarat, India")
  storeLatitude        Decimal? @db.Decimal(10, 7)
  storeLongitude       Decimal? @db.Decimal(10, 7)
  localRadiusKm        Decimal  @default(50) @db.Decimal(8, 2)
  localDeliveryCharge  Decimal  @default(350) @db.Decimal(10, 2)
  sameDayCutoff        String   @default("15:00")
  sameDayEnabled       Boolean  @default(true)
  indiaShippingEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model ShippingConfirmation {
  id              String                     @id @default(cuid())
  orderId         String                     @unique
  confirmedById   String
  method          ShippingConfirmationMethod
  charge          Decimal                    @db.Decimal(10, 2)
  customerConsent Boolean                    @default(true)
  note            String?
  confirmedAt     DateTime                   @default(now())
  confirmedBy     User                       @relation("ShippingConfirmedBy", fields: [confirmedById], references: [id])
  order           Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryOperation {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  managerId          String?
  packagingCost      Decimal? @db.Decimal(10, 2)
  courierCost        Decimal? @db.Decimal(10, 2)
  otherCost          Decimal? @db.Decimal(10, 2)
  revenue            Decimal? @db.Decimal(10, 2)
  profit             Decimal? @db.Decimal(10, 2)
  packagingChecklist Json?
  internalNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  manager            User?    @relation("DeliveryOperationManager", fields: [managerId], references: [id])
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryStatusHistory {
  id                String          @id @default(cuid())
  orderId           String
  fromStatus        DeliveryStatus?
  toStatus          DeliveryStatus
  note              String?
  actorUserId       String?
  actorType         OrderActorType
  isCustomerVisible Boolean         @default(true)
  createdAt         DateTime        @default(now())
  actorUser         User?           @relation("DeliveryStatusActor", fields: [actorUserId], references: [id])
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model DeliveryContactLog {
  id                String   @id @default(cuid())
  orderId           String
  actorUserId       String?
  channel           String
  outcome           String
  note              String?
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  actorUser         User?    @relation("DeliveryContactActor", fields: [actorUserId], references: [id])
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                String               @id @default(cuid())
  orderId           String
  userId            String
  provider          PaymentProvider      @default(RAZORPAY)
  providerOrderId   String               @unique
  providerPaymentId String?              @unique
  signatureHash     String?
  status            PaymentAttemptStatus @default(CREATED)
  amount            Decimal              @db.Decimal(10, 2)
  currency          String               @default("INR")
  method            String?
  email             String?
  contact           String?
  errorCode         String?
  errorDescription  String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  captured          Boolean              @default(false)
  verifiedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model PaymentEvent {
  id                String          @id @default(cuid())
  provider          PaymentProvider @default(RAZORPAY)
  providerEventId   String          @unique
  eventType         String
  providerOrderId   String?
  providerPaymentId String?
  payloadHash       String
  processed         Boolean         @default(false)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([eventType, createdAt])
}

model InventoryReservation {
  id              String                @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  status          ReservationStatus     @default(ACTIVE)
  expiresAt       DateTime
  releasedAt      DateTime?
  convertedAt     DateTime?
  createdAt       DateTime              @default(now())
  variantColourId String?
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id])
  variantColour   ProductVariantColour? @relation(fields: [variantColourId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([productId, status])
  @@index([orderId, variantColourId])
  @@index([variantColourId, status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model Enquiry {
  id              String           @id @default(cuid())
  enquiryNumber   String           @unique
  userId          String?
  orderId         String?
  name            String
  email           String
  phone           String?
  subject         String
  category        EnquiryCategory
  status          EnquiryStatus    @default(OPEN)
  priority        EnquiryPriority  @default(NORMAL)
  source          EnquirySource    @default(CONTACT_PAGE)
  internalNote    String?
  lastRespondedAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order?           @relation(fields: [orderId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  messages        EnquiryMessage[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([email])
}

model EnquiryMessage {
  id                String               @id @default(cuid())
  enquiryId         String
  authorUserId      String?
  authorType        EnquiryMessageAuthor
  message           String
  isCustomerVisible Boolean              @default(true)
  createdAt         DateTime             @default(now())
  authorUser        User?                @relation(fields: [authorUserId], references: [id])
  enquiry           Enquiry              @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
}

model Review {
  id               String         @id @default(cuid())
  productId        String
  userId           String
  orderId          String
  rating           Int
  title            String
  comment          String
  status           ReviewStatus   @default(PENDING)
  verifiedPurchase Boolean        @default(true)
  helpfulCount     Int            @default(0)
  reportCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order          @relation(fields: [orderId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports          ReviewReport[]
  votes            ReviewVote[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId, createdAt])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([createdAt])
}

model OrderItem {
  id                     String                @id @default(cuid())
  orderId                String
  productId              String?
  name                   String
  price                  Decimal               @db.Decimal(10, 2)
  quantity               Int
  brandName              String                @default("")
  categoryName           String                @default("")
  createdAt              DateTime              @default(now())
  imageUrl               String                @default("")
  lineTotal              Decimal               @default(0) @db.Decimal(10, 2)
  originalPrice          Decimal?              @db.Decimal(10, 2)
  productName            String                @default("")
  productSku             String?
  productSlug            String                @default("")
  productType            ProductType           @default(SMARTPHONE)
  specifications         Json?
  unitPrice              Decimal               @default(0) @db.Decimal(10, 2)
  colourName             String?
  productVariantColourId String?
  productVariantId       String?
  ram                    String?
  storage                String?
  variantSku             String?
  order                  Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product?              @relation(fields: [productId], references: [id])
  productVariantColour   ProductVariantColour? @relation(fields: [productVariantColourId], references: [id])
  productVariant         ProductVariant?       @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([productVariantColourId])
}

model OrderStatusHistory {
  id                String         @id @default(cuid())
  orderId           String
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  actorUserId       String?
  actorType         OrderActorType
  createdAt         DateTime       @default(now())
  isCustomerVisible Boolean        @default(true)
  actorUser         User?          @relation(fields: [actorUserId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

