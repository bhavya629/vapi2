# Runtime database connection (Supabase pooled connection recommended for the app)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true"

# Direct database connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE"

# Generate a strong, private value of at least 32 random bytes
JWT_SECRET="replace-with-a-long-random-secret"

# Add only when the Razorpay implementation phase begins
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"

# Canonical public origin, with no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Existing customer email to promote with scripts/promote-admin.js
ADMIN_EMAIL="admin@example.com"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENV=test
NEXT_PUBLIC_APP_URL=

# Cloudinary product image uploads (server-side only)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
